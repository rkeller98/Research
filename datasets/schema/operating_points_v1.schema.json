{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research:operating-points-v1",
  "title": "Portable research operating-point manifest",
  "type": "object",
  "required": ["schema_version", "dataset_id", "machine_type", "provenance", "columns", "dq_convention", "torque", "aggregation", "known_limitations", "data_rights", "csv_file", "row_count", "csv_sha256"],
  "properties": {
    "schema_version": {"const": "research-operating-points-v1"},
    "dataset_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
    "machine_type": {"enum": ["PSM", "EESM", "ASM", "unknown"]},
    "csv_file": {"type": "string", "pattern": "^[a-z][a-z0-9_]+\\.csv$"},
    "row_count": {"type": "integer", "minimum": 1},
    "csv_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provenance": {
      "type": "object", "required": ["sources", "exporter", "exporter_version", "machine_type_evidence"],
      "properties": {
        "sources": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\.\\.).+$"},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        }}
      }
    },
    "columns": {"type": "object", "minProperties": 1, "additionalProperties": {
      "type": "object", "required": ["unit", "source"],
      "properties": {"unit": {"type": "string", "minLength": 1}, "source": {"type": "string"}}
    }},
    "dq_convention": {"type": "object", "required": ["name", "evidence", "status", "axes", "electrical_speed"]},
    "torque": {"type": "object", "required": ["source_field", "status", "unit", "gain_applied", "sign", "kt"]},
    "aggregation": {"type": "object", "required": ["group_by", "estimator", "settling", "outliers", "flux", "reduction"]},
    "known_limitations": {"type": "array", "items": {"type": "string"}},
    "data_rights": {"type": "object", "required": ["derived_data_publication", "raw_data", "license"]}
  }
}
